# URL da API Shiro (opcional — o padrão é https://share.shirobot.xyz)
SHIRO_API_URL=https://share.shirobot.xyz

# Chave da API (header X-API-Key) — OBRIGATÓRIA para compilar o app.
# É embutida no app no momento do build (scripts/build-main.mjs) e não fica no código-fonte.
# Peça a chave a quem administra a API. Nunca faça commit do arquivo .env.
SHIRO_API_KEY=cole-a-chave-aqui

# Servidor STUN para P2P (padrão Google, pode substituir por TURN privado)
STUN_URL=stun:stun.l.google.com:19302
