# URL da API Shiro hospedada na Vercel
SHIRO_API_URL=https://shiro-api.vercel.app

# Chave de segurança para autenticar o app desktop com a API
# Esta chave é injetada pelo processo main do Electron — nunca exposta ao renderer
SHIRO_API_KEY=sua-chave-secreta-aqui

# Servidor STUN para P2P (padrão Google, pode substituir por TURN privado)
STUN_URL=stun:stun.l.google.com:19302
